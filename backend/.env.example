DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/authDB?retryWrites=true&w=majority"
JWT_SECRET="change-me-generate-a-strong-secret"
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@voxlate.com"
ADMIN_PASSWORD="change-me-min-8-chars"
PORT=3001
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3002"

GOOGLE_CLIENT_ID="your-google-client-id"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Voxlate <no-reply@voxlatesn.in>"
# Optional: comma-separated inbox(es) notified when someone uses "Ask us" on the homepage.
# Questions are always stored in the `questions` collection (GET /api/admin/questions).
QUESTIONS_NOTIFY_EMAIL=""
# Optional: inboxes for /contact messages (customers/freelancers, and investors if set separately).
CONTACT_NOTIFY_EMAIL=""
INVESTOR_NOTIFY_EMAIL=""

# Admin dashboard sign-in at /admin/login with a username (POST /api/auth/admin-login).
# ADMIN_PASSWORD_HASH is a bcrypt hash of the password, raw ("$2a$12$…") or base64-encoded.
# Generate one with: node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1], 12)).toString('base64'))" "<password>"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""


# Host-only cookies work through the frontend /api proxy and preview deployments.
# Set only if intentionally sharing sessions across subdomains:
# SESSION_COOKIE_DOMAIN=.voxlatesn.in
# Exact allowed frontend origins (comma separated); legacy NEXT_PUBLIC_FRONTEND_URL is supported.
FRONTEND_URL="http://localhost:3002"
